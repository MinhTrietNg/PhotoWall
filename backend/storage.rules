rules_version = '2';
// Uploads are gated on the Firestore photo doc, which is itself rate-limited by
// firestore.rules. Constants mirror backend/src/schema.ts (LIMITS) — keep in sync.
service firebase.storage {
  match /b/{bucket}/o {

    function photoDoc(photoId) {
      return firestore.get(/databases/(default)/documents/photos/$(photoId)).data;
    }

    function isModerator() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && firestore.exists(/databases/(default)/documents/moderators/$(request.auth.token.email));
    }

    function isAdmin() {
      return isModerator()
        && firestore.get(/databases/(default)/documents/moderators/$(request.auth.token.email)).data
          .get('role', 'moderator') == 'admin';
    }

    // Mirrors wipeDue() in firestore.rules: confirmed by two admins and due.
    function wipeDue() {
      let s = firestore.get(/databases/(default)/documents/config/app).data.get('deletionSchedule', null);
      return isAdmin() && s != null && s.confirmedBy != null && s.executedAt == null
        && request.time >= s.at;
    }

    function retention() {
      return duration.value(
        firestore.get(/databases/(default)/documents/config/app).data.get('removedRetentionHours', 24), 'h');
    }

    // strip.jpg is the 1080x3400 strip; thumb.jpg the same strip at 480 wide.
    match /photos/{photoId}/{file} {
      function maxBytes() {
        return file == 'thumb.jpg' ? 300 * 1024 : 2 * 1024 * 1024;
      }

      function canUpload(photo) {
        return file in ['strip.jpg', 'thumb.jpg']
          && request.auth != null
          && photo.ownerUid == request.auth.uid
          && photo.status == 'uploading'
          && request.resource.size < maxBytes()
          && request.resource.contentType == 'image/jpeg';
      }

      function canRead(photo) {
        return photo.status == 'approved'
          || (request.auth != null && photo.ownerUid == request.auth.uid);
      }

      // Removed/rejected strips (including a guest's own removal) are kept for the
      // retention window, then purged by a moderator's console.
      function canDelete(photo) {
        return isModerator()
          && photo.status in ['rejected', 'removed']
          && request.time >= photo.reviewedAt + retention();
      }

      allow create, update: if canUpload(photoDoc(photoId));
      allow read: if canRead(photoDoc(photoId)) || isModerator();
      allow delete: if wipeDue() || canDelete(photoDoc(photoId));
    }
  }
}
