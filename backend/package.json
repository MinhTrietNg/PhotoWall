 {
  "name": "@photowall/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-photowall",
    "test": "firebase emulators:exec --project demo-photowall --only auth,firestore,storage \"vitest run\"",
    "e2e": "firebase emulators:exec --project demo-photowall --only auth,firestore,storage \"tsx scripts/e2e-emulator.ts\"",
    "load-test": "firebase emulators:exec --project demo-photowall --only auth,firestore,storage \"tsx scripts/load-test.ts\"",
    "seed":"tsx scripts/seed-emulator.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
