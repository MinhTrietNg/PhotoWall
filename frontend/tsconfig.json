{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@backend/*": ["../backend/src/*"],
      // backend/src is compiled as part of this app, but Node resolution would
      // look for its imports in backend/node_modules. Point them at the copy the
      // frontend installed — the same one Vite's resolve.dedupe keeps single.
      "firebase": ["./node_modules/firebase"],
      "firebase/*": ["./node_modules/firebase/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
